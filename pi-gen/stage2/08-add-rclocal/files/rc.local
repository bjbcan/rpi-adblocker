#!/bin/sh -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.

# Print the IP address
_IP=$(hostname -I) || true
if [ "$_IP" ]; then
  printf "My IP address is %s\n" "$_IP"
fi

#
# setup IP display in login prompt
#
PRE_MSG="Debian GNU/Linux 12" # this is from the original /etc/issue
IP_ETH0=$(/sbin/ifconfig eth0 | grep 'inet ' | cut -f2 | awk '{ print $2}')
IP_WLAN0=$(/sbin/ifconfig wlan0 | grep 'inet ' | cut -f2 | awk '{ print $2}')

printf "%s %s %s\n\n%s %s\n\n" "$PRE_MSG" '\n' '\l' eth0:"$IP_ETH0", wlan0:"$IP_WLAN0" > "/etc/issue"

#
# enbable and start services
#
systemctl enable crontabui
systemctl start crontabui
systemctl enable internet-buttons
systemctl start internet-buttons
systemctl enable pihole_writeable.timer
systemctl start pihole_writeable.timer
systemctl enable pihole_writeable
systemctl start pihole_writeable
systemctl enable wifi_hotspot_disable.service
systemctl enable wifi_hotspot_disable.timer
systemctl start wifi_hotspot_disable.timer

# restarting these services since they fail to start after first-run
systemctl restart nginx
systemctl restart crontabui
systemctl restart internet-buttons

# add pihole to local DNS in pihole.toml
# Router address: same subnet as IP with last octet set to .1 (e.g. 192.168.1.50 -> 192.168.1.1)
router_from_ip() { echo "$1" | sed 's/\.[0-9]*$/.1/'; }
INTERFACE="eth0"
FILE=/etc/pihole/pihole.toml
IP_ADDRESS=$(ip -4 -o addr show "$INTERFACE" | awk '{print $4}' | cut -d'/' -f1)
ROUTER_ADDRESS=$(router_from_ip "$IP_ADDRESS")
if [ -n "$IP_ADDRESS" ]; then
    echo "The IPv4 address for $INTERFACE is: $IP_ADDRESS"
    sed -i "/^\[dns\]/,/^\[dhcp\]/ {
  0,/^\([[:space:]]*\)hosts[[:space:]]*=[[:space:]]*\[\]/ s//\1hosts = [\n    \"$IP_ADDRESS pihole pi.hole\"\n  ]/
}" $FILE 
else
    echo "Could not find an IPv4 address for $INTERFACE. Check the interface name." >&2
fi

START=$( echo $ROUTER_ADDRESS | cut -d'.' -f1-3 | sed 's/$/.201/' )
END=$( echo $ROUTER_ADDRESS | cut -d'.' -f1-3 | sed 's/$/.251/' )
NETMASK=255.255.255.0
ACTIVE=true
#sed -i "/^\[dhcp\]/,/^\[ntp\]/ {
#   0,/^\([[:space:]]*\)active[[:space:]]*=[[:space:]]*\"[^\"]*\"/ s//\1active = \"$ACTIVE\"/
#   0,/^\([[:space:]]*\)start[[:space:]]*=[[:space:]]*\"[^\"]*\"/ s//\1start = \"$START\"/
#   0,/^\([[:space:]]*\)end[[:space:]]*=[[:space:]]*\"[^\"]*\"/ s//\1end = \"$END\"/
#   0,/^\([[:space:]]*\)netmask[[:space:]]*=[[:space:]]*\"[^\"]*\"/ s//\1netmask = \"$NETMASK\"/
# }" $FILE 


echo "--= ==--- pihole.toml "
cat /etc/pihole/pihole.toml | grep -B2 -A3 "hosts\ ="
echo "--= ==--- pihole.toml "

# {"dhcp":{"active":true,"start":"192.168.1.201","end":"192.168.1.251","router":"192.168.1.1","netmask":"","leaseTime":"24h","ipv6":false,"rapidCommit":false,"multiDNS":true,"logging":false,"ignoreUnknownClients":false,"hosts":["AC:86:A3:C9:C6:3E,192.168.1.223,H-iphone14","0c:85:e1:96:9a:72,192.168.2.226,keeper8","80:04:5F:C5:56:9C,192.168.1.222,MalPhoneSE3","60:7E:C9:BC:DB:69,192.168.1.241,MalPhoneOld","1C:AF:4A:24:46:02,192.168.1.231,SamsungTV","88:3F:4A:DD:E8:96,192.168.1.201,Thermostat","E8:6E:3A:10:F5:30,192.168.1.210,PS5","60:DD:70:C7:C2:39,192.168.1.218,Brad-iPad-9","94:F6:D6:DB:FA:2D,192.168.1.236,SarahiPadAir","14:7D:DA:B1:26:B7,192.168.1.224,H-MBA","B0:A7:B9:FB:91:4C,192.168.1.220,RE505X","80:48:2C:90:37:68,192.168.1.237,WyzeSideYardCam","a0:9a:8e:50:39:01,192.168.1.225,S-MBA4","1E:DD:9C:7E:F3:30,192.168.1.217,el-mbpm4","10:cf:0f:40:b7:17,192.168.1.229,Mals-AppleWatch","2e:73:f6:a0:03:34,192.168.1.239,brad-mbpm1"]}}




exit 0
