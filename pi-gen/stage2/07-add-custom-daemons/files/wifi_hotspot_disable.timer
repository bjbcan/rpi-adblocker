[Unit]
Description=Schedule wifi_hotspot_disable after 300 seconds (5mins)
#RefuseManualStart=no  # Allow manual starts
#RefuseManualStop=no   # Allow manual stops

[Timer]
#Execute job if it missed a run due to machine being off
Persistent=true
#Run 300s seconds after boot for the first time
OnBootSec=300
#File describing job to execute
Unit=wifi_hotspot_disable.service

[Install]
WantedBy=timers.target